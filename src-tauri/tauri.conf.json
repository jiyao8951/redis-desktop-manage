{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Redis Desktop Manager",
  "version": "1.0.0",
  "identifier": "app.resp.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Redis Desktop Manager",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "publisher": "Redis Desktop Manager contributors",
    "copyright": "Copyright (c) Redis Desktop Manager contributors",
    "category": "DeveloperTool",
    "shortDescription": "Redis GUI client",
    "longDescription": "Redis Desktop Manager - a Redis GUI client (Tauri v2 rebuild).",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["English", "SimpChinese"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
